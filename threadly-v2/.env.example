# Add these in Netlify > Site configuration > Environment variables (not in the code)
SHEET_ID=the-long-id-from-your-google-sheet-url
GOOGLE_SERVICE_ACCOUNT_EMAIL=threadly@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
JWT_SECRET=type-a-long-random-sentence-here
ADMIN_PASSWORD=choose-a-strong-password
RAZORPAY_WEBHOOK_SECRET=make-up-a-secret-and-use-it-in-the-razorpay-webhook
BREVO_API_KEY=xkeysib-xxxxxxxx
MAIL_FROM=you@yourmail.com
# Where new tickets (complaints and queries) are emailed. Defaults to MAIL_FROM.
SUPPORT_EMAIL=your-support-email@gmail.com
SUPPORT_PHONE=8072796630

# Keep false until marketplace payout onboarding, inventory reservation and reconciliation are approved.
MARKETPLACE_SELLER_SALES_ENABLED=false

# Optional transactional inventory database (required before enabling checkout reservations)
# Keep the service-role key server-side only; never expose it to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
